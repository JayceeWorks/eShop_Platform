# API (copy to apps/api/.env)
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/simple_concepts_shop?schema=public"
JWT_SECRET=
JWT_REFRESH_SECRET=
OTP_PROVIDER_KEY=
STORAGE_BUCKET=
STORAGE_KEY=
STORAGE_SECRET=
ENABLED_PAYMENT_METHODS=["COD"]
# First admin, created by `npx prisma db seed`. Use a strong password.
ADMIN_NAME="Shop Owner"
ADMIN_PHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mobile (copy to apps/mobile/.env)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# Shop number for the "Call us" button, e.g. 9876543210. Leave empty to hide the button.
EXPO_PUBLIC_SHOP_PHONE=

# Phase 2
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
